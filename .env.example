# Copy to .env and fill in. Every value below is required in production.

NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# Postgres. docker-compose.yml publishes the container on 5433 to avoid
# clashing with a local Postgres already using 5432.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/puzzlearena

# Auth. Generate real secrets before deploying.
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:8080
COOKIE_SECRET=change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 raw bytes, base64. Encrypts AI provider API keys at rest.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=change-me

# Anyone with this code can register as a host.
ADMIN_SIGNUP_CODE=letmein

# Seeded as the default AI provider on first boot, when ai_providers is empty.
# NOTE: api.minimax.io is the global endpoint and is what platform keys
# (sk-cp-...) authenticate against; api.minimaxi.com is the mainland China
# endpoint and returns 401 for those keys. Either can be switched at runtime
# from /admin/ai without a redeploy.
AI_BASE_URL=https://api.minimax.io/v1
AI_API_KEY=
AI_MODEL=MiniMax-M3
AI_PROVIDER_NAME=MiniMax

# Set to 0 in tests so bots act instantly.
# BOT_THINK_MS=0
